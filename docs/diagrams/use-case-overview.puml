@startuml use-case-overview
!theme plain
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkOrange
  ArrowColor DarkGray
}

title Financial Management System — Visão Geral dos Casos de Uso

actor "Visitante" as Visitor #LightBlue
actor "Usuário\nAutenticado" as User #LightGreen

Visitor -|> User : <<extends>>

rectangle "Financial Management System" {

    package "Autenticação" as AuthPkg {
        usecase "UC001\nAutenticar Usuário" as UC001
        usecase "UC002\nEncerrar Sessão" as UC_LOGOUT
    }

    package "Dashboard" as DashPkg {
        usecase "UC002\nConsultar Dashboard" as UC002
    }

    package "Contas Financeiras" as AccountsPkg {
        usecase "UC003\nCadastrar Conta" as UC003
        usecase "UC004\nEditar Conta" as UC004
        usecase "UC005\nConsultar Contas" as UC005
    }

    package "Categorias" as CategoriesPkg {
        usecase "UC008\nGerenciar Categorias" as UC008
    }

    package "Transações" as TransactionsPkg {
        usecase "UC006\nCadastrar Transação" as UC006
        usecase "UC007\nConsultar e Filtrar\nTransações" as UC007
    }

    package "Importação de Extrato" as ImportPkg {
        usecase "UC009\nImportar Extrato CSV" as UC009
        usecase "UC010\nValidar Registros\nImportados" as UC010
        usecase "UC015\nConsultar Histórico\nde Importação" as UC015
    }

    package "Conciliação Financeira" as ReconciliationPkg {
        usecase "UC011\nConsultar Sugestões\nde Conciliação" as UC011
        usecase "UC012\nConfirmar Conciliação" as UC012
        usecase "UC013\nRejeitar Sugestão\nde Conciliação" as UC013
        usecase "UC014\nDesfazer Conciliação" as UC014
    }
}

Visitor --> UC001

User --> UC002
User --> UC_LOGOUT

User --> UC003
User --> UC004
User --> UC005

User --> UC008

User --> UC006
User --> UC007

User --> UC009
UC009 ..> UC010 : <<include>>
User --> UC015

User --> UC011
User --> UC012
User --> UC013
User --> UC014

UC012 ..> UC011 : <<extend>>
UC013 ..> UC011 : <<extend>>

@enduml
