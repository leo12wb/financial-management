# ============================================================
# Financial Management & Transaction Reconciliation System
# Environment variables — copy to .env and fill in your values
# ============================================================

# Symfony
APP_ENV=dev
APP_SECRET=replace_with_a_random_32_character_string

# Routing
DEFAULT_URI=http://localhost

# CORS — allow React dev server (Vite default port 5173)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# PostgreSQL 16
# Docker service name is "db"; use 127.0.0.1 if running locally without Docker
DATABASE_URL="postgresql://financial_user:financial_pass@db:5432/financial_db?serverVersion=16&charset=utf8"

# JWT Authentication (keys are generated via: php bin/console lexik:jwt:generate-keypair)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=replace_with_a_secure_passphrase

# Docker Compose (used only in compose.yaml)
POSTGRES_DB=financial_db
POSTGRES_USER=financial_user
POSTGRES_PASSWORD=financial_pass
POSTGRES_PORT=5432
APP_PORT=8080
FRONTEND_PORT=5173
